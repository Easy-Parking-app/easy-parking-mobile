# Plantilla de variables de entorno. Copia este archivo a `.env.local` y
# rellena los valores; `.env.local` esta en .gitignore y nunca se sube.
#
# Las claves reales estan en el gestor del equipo, no aqui.

# --- Supabase --------------------------------------------------------------
# Proyecto: easy-parking (region us-east-1). La anon/publishable key es publica
# por diseno: lo que protege los datos es RLS, no esconder esta cadena.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Maps -----------------------------------------------------------
# Proyecto GCP: Easy Parking. Una clave por plataforma: una clave solo admite
# un tipo de restriccion de aplicacion, asi que Android e iOS no pueden
# compartirla si queremos ambas restringidas.
EXPO_PUBLIC_GOOGLE_MAPS_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_KEY_IOS=
