{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Easy Parking: iniciar",
      "detail": "Servidor de desarrollo. Escanea el QR con Expo Go o pulsa w para abrir en el navegador.",
      "type": "shell",
      "command": "npx expo start --host lan --port 8081",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Easy Parking: iniciar (túnel)",
      "detail": "Usa esto si el QR no conecta: funciona aunque el celular esté en otra red",
      "type": "shell",
      "command": "npx expo start --tunnel --port 8081",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Easy Parking: web",
      "type": "shell",
      "command": "npx expo start --web --port 8081",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Easy Parking: typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": ["$tsc"],
      "group": "test",
      "presentation": { "panel": "dedicated" }
    }
  ]
